{
  "protocol": "jaz.browser.extension.v2",
  "bridge_path": "/v1/browser/extension",
  "actions": [
    "status",
    "tabs",
    "claim_tab",
    "navigate",
    "state",
    "find",
    "screenshot",
    "click",
    "form_input",
    "press",
    "scroll",
    "wait"
  ],
  "page_state": {
    "fields": ["url", "title", "ready_state", "page_revision", "text", "elements"],
    "element_fields": ["ref", "tag", "role", "name", "text", "href", "input_type", "value", "required", "disabled", "read_only", "checked", "validation"],
    "frame_ref_prefix": "f<frame_id>:"
  }
}
